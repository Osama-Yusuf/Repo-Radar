###### Frontend Configuration ######

# Backend API URL (optional, will be constructed using PORT if not provided)
BACKEND_BASE_URL=http://localhost:3001/api

###### Backend Configuration ######

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_API_URL=https://github.ibm.com/api/v3

# PostgreSQL Configuration
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_USER=repo_radar_user
POSTGRESQL_DATABASE=repo_radar
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432

# Authentication Configuration
JWT_SECRET=your-secret-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Kubernetes Configuration
K8S_TARGET_NAMESPACE=default

###### Shared Configuration ######

# Backend Port
PORT=3001