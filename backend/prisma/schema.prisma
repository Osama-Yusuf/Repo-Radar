generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            Int         @id @default(autoincrement())
  name          String
  repoUrl       String      @map("repo_url")
  checkInterval Int         @default(5) @map("check_interval")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @map("updated_at")
  branches      Branch[]
  checkLogs     CheckLog[]
  actions       Action[]

  @@map("projects")
}

model Branch {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  branchName   String   @map("branch_name")
  lastCommitSha String?  @map("last_commit_sha")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("branches")
}

model CheckLog {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  branchName    String   @map("branch_name")
  commitSha     String?  @map("commit_sha")
  commitMessage String?  @map("commit_message")
  commitAuthor  String?  @map("commit_author")
  commitDate    DateTime? @map("commit_date")
  checkedAt     DateTime @default(now()) @map("checked_at")
  status        String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("check_logs")
}

model Action {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  name          String?
  actionType    String   @map("action_type")
  webhookUrl    String?  @map("webhook_url")
  scriptContent String?  @map("script_content")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets       Secret[]

  @@map("actions")
}

model Secret {
  id        Int      @id @default(autoincrement())
  actionId  Int      @map("action_id")
  name      String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("secrets")
}
